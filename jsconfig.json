{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@utils/*": [
        "backend/helperUtils/*"
      ],
      "@models/*": [
        "backend/models/*"
      ],
      "@config/*": [
        "backend/config/*"
      ],
      "@controllersCommonModules/*": [
        "backend/commonModules/controllers/*"
      ],
      "@services/*": [
        "backend/services/*"
      ],
      "@assets/*": [
        "backend/assets/*"
      ],
      "@middlewares/*": [
        "backend/middlewares/*"
      ],
      "@notificationsUtil": [
        "backend/commonModules/communicationController.js"
      ],
      "@redisCache": [
        "backend/config/redis/redisCache.js"
      ],
      "@socketIo/*": [
        "backend/config/sockets/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}
